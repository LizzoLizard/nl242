  -- Step 1: Prove `4 ∣ z b1 b2 a` EVERYWHERE on `W 8` using affine weight classification!
  have hz_div4_all (b1 b2 : Bool) (a : W 8) : z b1 b2 a % 4 = 0 := by
    let ah : W 8 → Bool := fun c => decide ((z b1 b2 c / 2) % 2 = 1)
    have haff : ∀ p q c : W 8, xor (xor (ah (add 8 p (add 8 q c))) (ah (add 8 q c)))
        (xor (ah (add 8 p c)) (ah c)) = false := by
      intro p q c
      have hd2 := diff_transform_dvd [p, q] (Vcell b1 b2) c
      simp only [List.length_cons, List.length_nil, differences] at hd2
      obtain ⟨k, hk⟩ := hd2
      have hpow : (2 : Int) ^ (2 : Nat) = 4 := by decide
      rw [hpow] at hk
      change (((z b1 b2 (add 8 p (add 8 q c)) - z b1 b2 (add 8 q c)) -
        (z b1 b2 (add 8 p c) - z b1 b2 c))) = 4 * k at hk
