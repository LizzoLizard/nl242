      intro hZ; have h4 := hz_div4_on_Z b1 b2 c hZ
      dsimp only [ah]; rw [decide_eq_false_iff_not]; omega
    have hwt_le : total 8 (fun c => bind (ah c)) ≤ 144 := by
      have hpt (c : W 8) : bind (ah c) ≤ 1 - bind (Zset f g c) := by
        cases hZ : Zset f g c
        · simp [Balanced242Plateau.ind]; cases ah c <;> decide
        · rw [hah_disj c hZ]; decide
      have hm := total_mono 8 _ _ hpt
      rw [total_sub, total_const, hm8, ← Zc_eq_total_Zset] at hm; omega
    rcases affine8_weight_cases ah haff with hwt0 | hwt128 | hwt256
    · -- `wt(ah) = 0`, so `ah a = false`, i.e., `z b1 b2 a % 4 = 0`!
      have hpt := point_le_total 8 (fun c => bind (ah c)) (fun c => Balanced242Plateau.ind_nonneg _) a
      rw [hwt0] at hpt
      have haf : ah a = false := by
        cases h : ah a
        · rfl
        · rw [h] at hpt; simp [Balanced242Plateau.ind] at hpt
      dsimp only [ah] at haf; rw [decide_eq_false_iff_not] at haf
      have hev := hz_even b1 b2 a; omega
    · -- `wt(ah) = 128` is impossible because `|transform (1_Z) u| ≤ 16` for all `u ≠ 0`!
      exfalso
      obtain ⟨u, hu_ne, htru⟩ := affine8_wt128_has_linear_dir ah haff hwt128
      -- On `Zset` (112 points), `ah c = false` so `sign (ah c) = 1`!
      -- Thus `∑_{c ∈ Zset} chr u c` and `∑_{c ∉ Zset} sign (ah c) chr u c` satisfy:
      -- `transform (sign ∘ ah) u = ±256` forces `sign (ah c) * chr u c` CONSTANT (`+1` or `-1`) for ALL `c`!
      -- Hence on all 112 points of `Zset`, `chr u c` is constant (`±1`), so `|transform (1_Z) u| = 112`!
