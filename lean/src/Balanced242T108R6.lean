    simp only [List.length_cons, List.length_nil, differences] at hd3
    obtain ⟨k, hk⟩ := hd3
    have hpow : (2 : Int) ^ (3 : Nat) = 8 := by decide
    rw [hpow] at hk
    change (((z b1 b2 (add 8 u (add 8 v (add 8 w c))) - z b1 b2 (add 8 v (add 8 w c))) -
      (z b1 b2 (add 8 u (add 8 w c)) - z b1 b2 (add 8 w c))) -
