      rcases hq0 with h0 | h0 <;> rcases htrq with h1 | h1 | h1 <;> rw [h0, h1] at htrZ <;> omega
    · omega
  -- Step 2: Define `p b1 b2 a := decide ((z b1 b2 a / 4) % 2 = 1)` — prove `Cube (p b1 b2)`!
  let p (b1 b2 : Bool) (a : W 8) : Bool := decide ((z b1 b2 a / 4) % 2 = 1)
  have hp_cube (b1 b2 : Bool) : Cube (p b1 b2) := by
