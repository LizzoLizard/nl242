      by_cases h : n % 2 = 1 <;> simp [h] <;> omega
    dsimp only [p]
    apply bool8_xor_of_sum_mod2
    rw [hbit, hbit, hbit, hbit, hbit, hbit, hbit, hbit]
    omega
  -- Step 3: On `Zset`, all 4 `p b1 b2 a` are EQUAL; off `Zset`, EXACTLY ONE is `true` and has `|z| = 12`!
  have hp_on_Z (b1 b2 c1 c2 : Bool) (a : W 8) (hZ : Zset f g a = true) :
      p b1 b2 a = p c1 c2 a := by
    have hf1 := hz_formula b1 b2 a
    have hf2 := hz_formula c1 c2 a
    cases hr : rad (β8 f g) a
    · have hnr1 : rad (β8 f g) (add 8 a e1) = false := by rw [add_comm, rad_add _ _ he1_rad]; exact hr
      have hnr2 : rad (β8 f g) (add 8 a e2) = false := by rw [add_comm, rad_add _ _ he2_rad]; exact hr
      have hnr3 : rad (β8 f g) (add 8 a (add 8 e1 e2)) = false := by rw [add_comm, rad_add _ _ he3_rad]; exact hr
      have h0 := (hlo2_val a).2.1 hr hZ
      have h1 := (hlo2_val (add 8 a e1)).2.1 hnr1 (by rw [hZ_shift a e1 he1_rad, hZ])
      have h2 := (hlo2_val (add 8 a e2)).2.1 hnr2 (by rw [hZ_shift a e2 he2_rad, hZ])
      have h3 := (hlo2_val (add 8 a (add 8 e1 e2))).2.1 hnr3 (by rw [hZ_shift a (add 8 e1 e2) he3_rad, hZ])
      have hz1 : z b1 b2 a = ((lo f g a / 2) + sign b1 * (lo f g (add 8 a e1) / 2) +
          sign b2 * (lo f g (add 8 a e2) / 2) + (sign b1 * sign b2) * (lo f g (add 8 a (add 8 e1 e2)) / 2)) / 4 := by omega
      have hz2 : z c1 c2 a = ((lo f g a / 2) + sign c1 * (lo f g (add 8 a e1) / 2) +
          sign c2 * (lo f g (add 8 a e2) / 2) + (sign c1 * sign c2) * (lo f g (add 8 a (add 8 e1 e2)) / 2)) / 4 := by omega
      dsimp only [p]; rw [hz1, hz2]
      exact (walsh4_mod8_eq_00 _ _ _ _ h0 h1 h2 h3 b1 b2).trans
        (walsh4_mod8_eq_00 _ _ _ _ h0 h1 h2 h3 c1 c2).symm
    · have hr1 : rad (β8 f g) (add 8 a e1) = true := by rw [add_comm, rad_add _ _ he1_rad]; exact hr
      have hr2 : rad (β8 f g) (add 8 a e2) = true := by rw [add_comm, rad_add _ _ he2_rad]; exact hr
      have hr3 : rad (β8 f g) (add 8 a (add 8 e1 e2)) = true := by rw [add_comm, rad_add _ _ he3_rad]; exact hr
      rw [(hlo2_val a).1 hr, (hlo2_val _).1 hr1, (hlo2_val _).1 hr2, (hlo2_val _).1 hr3] at hf1 hf2
      have hz1 : z b1 b2 a = 0 := by omega
      have hz2 : z c1 c2 a = 0 := by omega
      dsimp only [p]; rw [hz1, hz2]
  have hp_off_Z (a : W 8) (hZ : Zset f g a = false) :
      (bind (p false false a) + bind (p false true a) + bind (p true false a) + bind (p true true a) = 1) ∧
      (∀ b1 b2, p b1 b2 a = true → z b1 b2 a * z b1 b2 a = 144) := by
    have hf00 := hz_formula false false a
    have hf01 := hz_formula false true a
    have hf10 := hz_formula true false a
    have hf11 := hz_formula true true a
    have hd00 := hz_div4_all false false a
    have h0 := (hlo2_val a).2.2 hZ
    have h1 := (hlo2_val (add 8 a e1)).2.2 (by rw [hZ_shift a e1 he1_rad, hZ])
    have h2 := (hlo2_val (add 8 a e2)).2.2 (by rw [hZ_shift a e2 he2_rad, hZ])
    have h3 := (hlo2_val (add 8 a (add 8 e1 e2))).2.2 (by rw [hZ_shift a (add 8 e1 e2) he3_rad, hZ])
    simp only [sign, Bool.false_eq_true, if_false, if_true] at hf00 hf01 hf10 hf11
    let v0 := lo f g a / 2
    let v1 := lo f g (add 8 a e1) / 2
    let v2 := lo f g (add 8 a e2) / 2
    let v3 := lo f g (add 8 a (add 8 e1 e2)) / 2
    have z00 : z false false a = (v0 + v1 + v2 + v3) / 4 := by dsimp only [v0, v1, v2, v3]; omega
    have z01 : z false true a = (v0 + v1 - v2 - v3) / 4 := by dsimp only [v0, v1, v2, v3]; omega
    have z10 : z true false a = (v0 - v1 + v2 - v3) / 4 := by dsimp only [v0, v1, v2, v3]; omega
    have z11 : z true true a = (v0 - v1 - v2 + v3) / 4 := by dsimp only [v0, v1, v2, v3]; omega
    rw [z00] at hd00
    have hw := walsh4_12_weight1 v0 v1 v2 v3 h0 h1 h2 h3 hd00
    dsimp only [p]
    constructor
    · rw [z00, z01, z10, z11]; exact hw.1
    · intro b1 b2 hp
      cases b1 <;> cases b2
      · rw [z00] at hp ⊢; exact hw.2.1 hp
      · rw [z01] at hp ⊢; exact hw.2.2.1 hp
      · rw [z10] at hp ⊢; exact hw.2.2.2.1 hp
      · rw [z11] at hp ⊢; exact hw.2.2.2.2 hp
  -- Step 4: `Cube (!Zset f g)` on `W 8` (since `Zset` is quadratic by `hZe`!)
  have hZ_cube : Cube (fun a => !Zset f g a) := by
    have hZnot (x : W 8) :
        (!Zset f g x) = xor (xor (β8 f g x) (β8 f g (zero 8))) (dot 8 (supportXor g) x) := by
      have h := hZe x; rw [dot_comm 8 x (supportXor g)] at h
      cases h1 : Zset f g x <;> cases h2 : xor (xor (β8 f g x) (β8 f g (zero 8))) (dot 8 (supportXor g) x) <;>
        rw [h1, h2] at h <;> simp at h ⊢
    intro u v w a
    have hcb := cube8 f g res u v w a
    dsimp only
    rw [hZnot, hZnot, hZnot, hZnot, hZnot, hZnot, hZnot, hZnot]
    simp only [dot_right]
    have hlin (b7 b6 b5 b4 b3 b2 b1 b0 bz du dv dw da : Bool) :
        xor (xor (xor (xor (xor b7 bz) (xor du (xor dv (xor dw da))))
                      (xor (xor b6 bz) (xor dv (xor dw da))))
                 (xor (xor (xor b5 bz) (xor du (xor dw da)))
                      (xor (xor b4 bz) (xor dw da))))
            (xor (xor (xor (xor b3 bz) (xor du (xor dv da)))
                      (xor (xor b2 bz) (xor dv da)))
                 (xor (xor (xor b1 bz) (xor du da))
                      (xor (xor b0 bz) da))) =
        xor (xor (xor b7 b6) (xor b5 b4)) (xor (xor b3 b2) (xor b1 b0)) := by
      have step (x y c d e : Bool) :
          xor (xor (xor x c) (xor d e)) (xor (xor y c) e) = xor (xor x y) d := by
        cases x <;> cases y <;> cases c <;> cases d <;> cases e <;> rfl
      rw [step b7 b6 bz du (xor dv (xor dw da)),
          step b5 b4 bz du (xor dw da),
          step b3 b2 bz du (xor dv da),
          step b1 b0 bz du da,
          xor_cancel_pair, xor_cancel_pair]
    rw [hlin]; exact hcb
  -- Step 5: Every pairwise XOR `g_xy := p_x ⊕ p_y` is constant on `{!Zset}`!
  have hpair_const (b1 b2 c1 c2 : Bool) :
      (∀ a, Zset f g a = false → xor (p b1 b2 a) (p c1 c2 a) = false) ∨
      (∀ a, Zset f g a = false → xor (p b1 b2 a) (p c1 c2 a) = true) := by
    let g1 : W 8 → Bool := fun a => xor (p b1 b2 a) (p c1 c2 a)
    let g2 : W 8 → Bool := fun a => xor (g1 a) (!Zset f g a)
    have hcube_xor (h1 h2 : W 8 → Bool) (c1' : Cube h1) (c2' : Cube h2) :
        Cube (fun a => xor (h1 a) (h2 a)) := by
      intro u v w a
      have k1 := c1' u v w a; have k2 := c2' u v w a
      have h4 (a1 a2 a3 a4 b1 b2 b3 b4 : Bool) :
          xor (xor (xor a1 b1) (xor a2 b2)) (xor (xor a3 b3) (xor a4 b4)) =
          xor (xor (xor a1 a2) (xor a3 a4)) (xor (xor b1 b2) (xor b3 b4)) := by
        rw [xor_interchange a1 a2 b1 b2, xor_interchange a3 a4 b3 b4, xor_interchange]
      dsimp only
      rw [h4 (h1 _) (h1 _) (h1 _) (h1 _) (h2 _) (h2 _) (h2 _) (h2 _),
          h4 (h1 _) (h1 _) (h1 _) (h1 _) (h2 _) (h2 _) (h2 _) (h2 _),
          xor_interchange, k1, k2]; rfl
    have hcg1 : Cube g1 := hcube_xor (p b1 b2) (p c1 c2) (hp_cube b1 b2) (hp_cube c1 c2)
    have hcg2 : Cube g2 := hcube_xor g1 (fun a => !Zset f g a) hcg1 hZ_cube
    have hsum144 : total 8 (fun a => bind (g1 a)) + total 8 (fun a => bind (g2 a)) = 144 := by
      rw [← total_add]
      have hpt (a : W 8) : bind (g1 a) + bind (g2 a) = 1 - bind (Zset f g a) := by
        dsimp only [g2]
        cases hZ : Zset f g a
        · simp [Balanced242Plateau.ind]; cases g1 a <;> decide
        · have hg0 : g1 a = false := by dsimp only [g1]; rw [hp_on_Z b1 b2 c1 c2 a hZ]; simp
          rw [hg0]; decide
      rw [funext hpt, total_sub, total_const, hm8, ← Zc_eq_total_Zset]; omega
    have hw1 := cube8_weight_cases g1 hcg1
    have hw2 := cube8_weight_cases g2 hcg2
    dsimp only at hw1 hw2
    -- `wt(g1) + wt(g2) = 144` forces `wt(g1) = 0 ∨ wt(g2) = 0`!
    have h0or0 : total 8 (fun a => bind (g1 a)) = 0 ∨ total 8 (fun a => bind (g2 a)) = 0 := by omega
    rcases h0or0 with h0 | h0
    · left; intro a _
      have hp := point_le_total 8 (fun x => bind (g1 x)) (fun x => Balanced242Plateau.ind_nonneg _) a
      rw [h0] at hp; cases hg : g1 a
      · exact hg
      · rw [hg] at hp; simp [Balanced242Plateau.ind] at hp
    · right; intro a hZ
      have hp := point_le_total 8 (fun x => bind (g2 x)) (fun x => Balanced242Plateau.ind_nonneg _) a
      rw [h0] at hp; dsimp only [g2] at hp; rw [hZ] at hp
      cases hg : g1 a
      · rw [hg] at hp; simp [Balanced242Plateau.ind] at hp
      · exact hg
  -- Step 6: Pick ONE `a0` with `Zset f g a0 = false` and let `(b1*, b2*)` be its unique peak cell!
  have hex_a0 : ∃ a0 : W 8, Zset f g a0 = false := by
    cases hall : (worlds 8).all (fun a => Zset f g a)
    · obtain ⟨a0, _, ha0⟩ := all_false_exists _ _ hall; exact ⟨a0, ha0⟩
    · exfalso; rw [List.all_eq_true] at hall
      have h256 : Zc f g = 256 := by
        rw [Zc_eq_total_Zset]
        have h1 : (fun a => bind (Zset f g a)) = fun _ => (1 : Int) := by
          funext a; rw [hall a (all_worlds 8 a)]; rfl
        rw [h1, total_const, hm8]; omega
      omega
  obtain ⟨a0, ha0⟩ := hex_a0
  have hex_star : ∃ b1s b2s : Bool, p b1s b2s a0 = true := by
    have h1 := (hp_off_Z a0 ha0).1
    cases h00 : p false false a0; cases h01 : p false true a0
    cases h10 : p true false a0; cases h11 : p true true a0
    · rw [h00, h01, h10, h11] at h1; simp [Balanced242Plateau.ind] at h1
    · exact ⟨true, true, h11⟩
    · exact ⟨true, false, h10⟩
    · exact ⟨false, true, h01⟩
    · exact ⟨false, false, h00⟩
  obtain ⟨b1s, b2s, hp_star0⟩ := hex_star
  -- Prove `p b1s b2s a = true` for EVERY `a` with `Zset f g a = false`!
  have hall_star (a : W 8) (hZ : Zset f g a = false) : p b1s b2s a = true := by
    cases hs : p b1s b2s a
    · exfalso
      -- At `a0`: `p b1s b2s a0 = true` and ALL other 3 cells have `p c1 c2 a0 = false`!
      -- Thus for every `(c1, c2) ≠ (b1s, b2s)`, `xor (p b1s b2s a0) (p c1 c2 a0) = true`,
      -- so by `hpair_const`, `xor (p b1s b2s a) (p c1 c2 a) = true`!
      -- Since `p b1s b2s a = false`, ALL 3 OTHER CELLS must have `p c1 c2 a = true`,
      -- giving Hamming weight `3 ≠ 1`, contradiction!
      have hother (c1 c2 : Bool) (hne : (c1, c2) ≠ (b1s, b2s)) : p c1 c2 a = true := by
        have h0_false : p c1 c2 a0 = false := by
          have hw1 := (hp_off_Z a0 ha0).1
          cases h00 : p false false a0 <;> cases h01 : p false true a0 <;>
          cases h10 : p true false a0 <;> cases h11 : p true true a0 <;>
          (rw [h00, h01, h10, h11] at hw1; simp [Balanced242Plateau.ind] at hw1;
           try (cases b1s <;> cases b2s <;> cases c1 <;> cases c2 <;>
             simp [h00, h01, h10, h11] at hp_star0 hne ⊢))
        rcases hpair_const b1s b2s c1 c2 with hconstF | hconstT
        · have hf0 := hconstF a0 ha0; rw [hp_star0, h0_false] at hf0; exact Bool.noConfusion hf0
        · have ht := hconstT a hZ; rw [hs] at ht; simpa using ht
      have hwa := (hp_off_Z a hZ).1
      cases b1s <;> cases b2s
      · have h01 := hother false true (by decide)
        have h10 := hother true false (by decide)
        have h11 := hother true true (by decide)
        rw [hs, h01, h10, h11] at hwa; simp [Balanced242Plateau.ind] at hwa
      · have h00 := hother false false (by decide)
        have h10 := hother true false (by decide)
        have h11 := hother true true (by decide)
        rw [h00, hs, h10, h11] at hwa; simp [Balanced242Plateau.ind] at hwa
      · have h00 := hother false false (by decide)
        have h01 := hother false true (by decide)
        have h11 := hother true true (by decide)
        rw [h00, h01, hs, h11] at hwa; simp [Balanced242Plateau.ind] at hwa
      · have h00 := hother false false (by decide)
        have h01 := hother false true (by decide)
        have h10 := hother true false (by decide)
        rw [h00, h01, h10, hs] at hwa; simp [Balanced242Plateau.ind] at hwa
    · rfl
  -- Step 7: Parseval on `Vcell b1s b2s` gives `20736 ≤ 16384`, contradiction!
  have hpar := Balanced242Section0320.parseval (Vcell b1s b2s)
  rw [hm8] at hpar
  have hlow_bound : 20736 ≤ total 8 (fun a => z b1s b2s a * z b1s b2s a) := by
    have hpt (a : W 8) : 144 * (1 - bind (Zset f g a)) ≤ z b1s b2s a * z b1s b2s a := by
      cases hZ : Zset f g a
      · simp only [Balanced242Plateau.ind, Bool.false_eq_true, if_false, Int.sub_zero, Int.mul_one]
        have h144 := (hp_off_Z a hZ).2 b1s b2s (hall_star a hZ)
        omega
      · simp only [Balanced242Plateau.ind, if_true, Int.sub_self, Int.mul_zero]
        have hsq : 0 ≤ z b1s b2s a ∨ z b1s b2s a ≤ 0 := by omega
        rcases hsq with h | h
        · exact Int.mul_nonneg h h
        · exact Int.mul_nonneg_of_nonpos_of_nonpos h h
    have hm := total_mono 8 _ _ hpt
    rw [total_scale, total_sub, total_const, hm8, ← Zc_eq_total_Zset, hZc] at hm
    omega
  have hup_bound : total 8 (fun y => Vcell b1s b2s y * Vcell b1s b2s y) ≤ 64 := by
    have hpt (y : W 8) : Vcell b1s b2s y * Vcell b1s b2s y ≤ bind (cellInd b1s b2s y) := by
      dsimp only [Vcell]; unfold Balanced242Plateau.ind Vtbl
      cases cellInd b1s b2s y
      · simp
      · cases f y <;> cases g y <;> decide
    have hm := total_mono 8 _ _ hpt
    rw [hcell_size b1s b2s] at hm; exact hm
  change total 8 (fun a => z b1s b2s a * z b1s b2s a) = 256 * total 8 (fun y => Vcell b1s b2s y * Vcell b1s b2s y) at hpar
  omega

end Balanced242T108R6

