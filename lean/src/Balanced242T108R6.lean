/-- Every `Cube` Boolean function `h` on `W 8` has Hamming weight in
    `{0, 64, 96, 112, 120, 128, 136, 144, 160, 192, 256}`! -/
theorem cube8_weight_cases (h : W 8 → Bool) (hc : Cube h) :
    let wt := total 8 (fun x => bind (h x))
    wt = 0 ∨ wt = 64 ∨ wt = 96 ∨ wt = 112 ∨ wt = 120 ∨ wt = 128 ∨
    wt = 136 ∨ wt = 144 ∨ wt = 160 ∨ wt = 192 ∨ wt = 256 := by
  intro wt
  have htr0 : transform (fun x => sign (h x)) (zero 8) = 256 - 2 * wt := by
    unfold transform
    have hpt (x : W 8) : sign (h x) * chr (zero 8) x = 1 - 2 * bind (h x) := by
      simp only [chr, dot_zero, sign, Balanced242Plateau.ind]; cases h x <;> decide
    rw [funext hpt, total_sub, total_const, total_scale]
    have hm8 : many 8 = 256 := by decide
    rw [hm8]; rfl
  have hsq := spec_good h hc (zero 8)
  rw [htr0] at hsq
  have hm8 : many 8 = 256 := by decide
  rw [hm8] at hsq
  cases hg : good h (zero 8)
  · rw [hg] at hsq; change (256 - 2 * wt) * (256 - 2 * wt) = 256 * (rr h * 0) at hsq
    have h0 : 256 - 2 * wt = 0 := by
      rcases Int.mul_eq_zero.1 (by omega : (256 - 2 * wt) * (256 - 2 * wt) = 0) with e | e <;> exact e
    omega
  · rw [hg] at hsq; change (256 - 2 * wt) * (256 - 2 * wt) = 256 * (rr h * 1) at hsq
    rw [Int.mul_one] at hsq
    have hrg := rr_good h hc; rw [hm8] at hrg
    have hrr_pos := rr_pos h
    have hcg_nn : 0 ≤ total 8 (fun y => bind (good h y)) :=
      total_nonneg _ (fun y => Balanced242Plateau.ind_nonneg _)
    have hlev := Balanced242Global.levels256 (rr h) (total 8 (fun y => bind (good h y))) hrg hrr_pos hcg_nn
      (256 - 2 * wt) hsq
    rcases hlev with ⟨hrr, _⟩ | ⟨hrr, _⟩ | ⟨hrr, _⟩ | ⟨hrr, _⟩ | ⟨hrr, _⟩
    · rw [hrr] at hsq
      rcases sq_cases (256 - 2 * wt) 16 (by omega) with e | e <;> omega
    · rw [hrr] at hsq
      rcases sq_cases (256 - 2 * wt) 32 (by omega) with e | e <;> omega
    · rw [hrr] at hsq
      rcases sq_cases (256 - 2 * wt) 64 (by omega) with e | e <;> omega
    · rw [hrr] at hsq
      rcases sq_cases (256 - 2 * wt) 128 (by omega) with e | e <;> omega
    · rw [hrr] at hsq
      rcases sq_cases (256 - 2 * wt) 256 (by omega) with e | e <;> omega

/-- An affine Boolean function (`∀ p q a, h(a⊕p⊕q) ⊕ h(a⊕p) ⊕ h(a⊕q) ⊕ h(a) = false`) on `W 8`
    has weight `0`, `128`, or `256`! -/
theorem affine8_weight_cases (h : W 8 → Bool)
    (haff : ∀ p q a : W 8, xor (xor (h (add 8 p (add 8 q a))) (h (add 8 q a)))
      (xor (h (add 8 p a)) (h a)) = false) :
    let wt := total 8 (fun x => bind (h x))
    wt = 0 ∨ wt = 128 ∨ wt = 256 := by
  intro wt
  have hc : Cube h := by
    intro u v w a
    have h1 := haff u v (add 8 w a)
    have h2 := haff u v a
    rw [h1, h2]; rfl
  have hrad_all (d : W 8) : rad h d = true := by
    rw [rad_spec]; intro a; unfold ell
    have h1 := haff a d (zero 8)
    rw [add_zero_right, add_zero_right] at h1
    revert h1
    generalize h (add 8 a d) = x; generalize h d = y; generalize h a = z; generalize h (zero 8) = w
    revert x y z w; decide
  have hrr256 : rr h = 256 := by
    unfold rr; have h1 : (fun d => bind (rad h d)) = fun _ => (1 : Int) := by
      funext d; rw [hrad_all d]; rfl
    rw [h1, total_const]; decide
  have htr0 : transform (fun x => sign (h x)) (zero 8) = 256 - 2 * wt := by
    unfold transform
    have hpt (x : W 8) : sign (h x) * chr (zero 8) x = 1 - 2 * bind (h x) := by
      simp only [chr, dot_zero, sign, Balanced242Plateau.ind]; cases h x <;> decide
    rw [funext hpt, total_sub, total_const, total_scale]
    have hm8 : many 8 = 256 := by decide
    rw [hm8]; rfl
  have hsq := spec_good h hc (zero 8)
  rw [htr0, hrr256] at hsq
  have hm8 : many 8 = 256 := by decide
  rw [hm8] at hsq
  cases hg : good h (zero 8)
  · rw [hg] at hsq; change (256 - 2 * wt) * (256 - 2 * wt) = 256 * (256 * 0) at hsq
    rcases Int.mul_eq_zero.1 (by omega : (256 - 2 * wt) * (256 - 2 * wt) = 0) with e | e <;> omega
  · rw [hg] at hsq; change (256 - 2 * wt) * (256 - 2 * wt) = 256 * (256 * 1) at hsq
    rcases sq_cases (256 - 2 * wt) 256 (by omega) with e | e <;> omega

/-- If `h : W 8 → Bool` is affine and `wt(h) = 128`, then `h` is a 7-flat indicator, so
    `∃ u ≠ zero 8, ∃ c, ∀ a, h a = decide (dot 8 u a = c)` — hence `transform (bind ∘ h) u = ±128`! -/
private theorem affine8_wt128_has_linear_dir (h : W 8 → Bool)
    (haff : ∀ p q a : W 8, xor (xor (h (add 8 p (add 8 q a))) (h (add 8 q a)))
      (xor (h (add 8 p a)) (h a)) = false)
    (hwt : total 8 (fun x => bind (h x)) = 128) :
    ∃ u : W 8, u ≠ zero 8 ∧
      (transform (fun x => sign (h x)) u = 256 ∨ transform (fun x => sign (h x)) u = -256) := by
  have hc : Cube h := fun u v w a => by rw [haff u v (add 8 w a), haff u v a]; rfl
  have hrad_all (d : W 8) : rad h d = true := by
    rw [rad_spec]; intro a; unfold ell
    have h1 := haff a d (zero 8)
    rw [add_zero_right, add_zero_right] at h1
    revert h1
    generalize h (add 8 a d) = x; generalize h d = y; generalize h a = z; generalize h (zero 8) = w
    revert x y z w; decide
  have hrr256 : rr h = 256 := by
    unfold rr; have h1 : (fun d => bind (rad h d)) = fun _ => (1 : Int) := by
      funext d; rw [hrad_all d]; rfl
    rw [h1, total_const]; decide
  have hcg1 : total 8 (fun y => bind (good h y)) = 1 := by
    have hrg := rr_good h hc; have hm8 : many 8 = 256 := by decide
    rw [hrr256, hm8] at hrg; omega
  cases hall : (worlds 8).all (fun y => !good h y)
  · obtain ⟨u, _, hu⟩ := all_false_exists _ _ hall
    have hgu : good h u = true := by cases hg : good h u <;> rw [hg] at hu <;> simp_all
    have hsq := spec_good h hc u
    have hm8 : many 8 = 256 := by decide
    rw [hrr256, hgu, hm8] at hsq
    change transform (fun x => sign (h x)) u * transform (fun x => sign (h x)) u = 256 * (256 * 1) at hsq
    have htr : transform (fun x => sign (h x)) u = 256 ∨ transform (fun x => sign (h x)) u = -256 :=
      sq_cases _ 256 (by omega)
    have hu_ne : u ≠ zero 8 := by
      intro hz; subst hz
      have htr0 : transform (fun x => sign (h x)) (zero 8) = 0 := by
        unfold transform
        have hpt (x : W 8) : sign (h x) * chr (zero 8) x = 1 - 2 * bind (h x) := by
          simp only [chr, dot_zero, sign, Balanced242Plateau.ind]; cases h x <;> decide
        rw [funext hpt, total_sub, total_const, total_scale, hm8, hwt]; omega
      omega
    exact ⟨u, hu_ne, htr⟩
  · exfalso; rw [List.all_eq_true] at hall
    have hz : (fun y => bind (good h y)) = fun _ => (0 : Int) := by
      funext y; have hy := hall y (all_worlds 8 y)
      cases hg : good h y <;> rw [hg] at hy <;> simp [Balanced242Plateau.ind] at hy ⊢
    rw [hz, total_zero] at hcg1; omega

/-- Constructive 2-element basis `(e1, e2)` for a 4-point radical `rad β` (`rr β = 4`). -/
private theorem radical4_basis (β : W 8 → Bool) (hrr : rr β = 4) :
    ∃ e1 e2 : W 8,
      e1 ≠ zero 8 ∧ e2 ≠ zero 8 ∧ e1 ≠ e2 ∧
      rad β e1 = true ∧ rad β e2 = true ∧ rad β (add 8 e1 e2) = true ∧
      ∀ w : W 8, rad β w = true ↔ (w = zero 8 ∨ w = e1 ∨ w = e2 ∨ w = add 8 e1 e2) := by
  -- Find `e1 ≠ 0` in `rad β`:
  have hex1 : ∃ e1 : W 8, e1 ≠ zero 8 ∧ rad β e1 = true := by
    cases hall : (worlds 8).all (fun d => decide (d = zero 8) || !rad β d)
    · obtain ⟨e1, _, he1⟩ := all_false_exists _ _ hall
      refine ⟨e1, fun hz => by subst hz; simp at he1, ?_⟩
      cases h : rad β e1 <;> rw [h] at he1 <;> simp_all
    · exfalso; rw [List.all_eq_true] at hall
      have hle : rr β ≤ 1 := by
        have hpt (d : W 8) : bind (rad β d) ≤ hits (zero 8) d := by
          have hd := hall d (all_worlds 8 d)
          by_cases hz : d = zero 8
          · subst hz; unfold hits; simp; cases rad β (zero 8) <;> decide
          · have hne : ¬ zero 8 = d := fun h => hz h.symm
            rw [decide_eq_false hz, Bool.false_or] at hd
            have hf : rad β d = false := by cases h : rad β d <;> rw [h] at hd <;> simp_all
            unfold hits; simp [hne, hf, Balanced242Plateau.ind]
        have hm := total_mono 8 _ _ hpt; rw [diagonal] at hm; exact hm
      omega
  obtain ⟨e1, he1_ne, he1_rad⟩ := hex1
  -- Find `e2 ∉ {0, e1}` in `rad β`:
  have hex2 : ∃ e2 : W 8, e2 ≠ zero 8 ∧ e2 ≠ e1 ∧ rad β e2 = true := by
    cases hall : (worlds 8).all (fun d => decide (d = zero 8) || decide (d = e1) || !rad β d)
    · obtain ⟨e2, _, he2⟩ := all_false_exists _ _ hall
      have hne0 : e2 ≠ zero 8 := fun hz => by subst hz; simp at he2
      have hne1 : e2 ≠ e1 := fun hz => by subst hz; simp at he2
      have hrad : rad β e2 = true := by cases h : rad β e2 <;> rw [h] at he2 <;> simp_all
      exact ⟨e2, hne0, hne1, hrad⟩
    · exfalso; rw [List.all_eq_true] at hall
      have hle : rr β ≤ 2 := by
        have hpt (d : W 8) : bind (rad β d) ≤ hits (zero 8) d + hits e1 d := by
          have hd := hall d (all_worlds 8 d)
          unfold hits
          by_cases h0 : zero 8 = d
          · subst h0; simp; cases rad β (zero 8) <;> split <;> decide
          · by_cases h1 : e1 = d
            · subst h1; simp [h0]; cases rad β e1 <;> decide
            · have h0' : d ≠ zero 8 := fun e => h0 e.symm
              have h1' : d ≠ e1 := fun e => h1 e.symm
              rw [decide_eq_false h0', decide_eq_false h1'] at hd
              have hf : rad β d = false := by cases h : rad β d <;> rw [h] at hd <;> simp_all
              simp [h0, h1, hf, Balanced242Plateau.ind]
        have hm := total_mono 8 _ _ hpt; rw [total_add, diagonal, diagonal] at hm; exact hm
      omega
  obtain ⟨e2, he2_ne, he2_ne1, he2_rad⟩ := hex2
  have he3_rad : rad β (add 8 e1 e2) = true := by rw [rad_add β e1 he1_rad e2]; exact he2_rad
  have he3_ne0 : add 8 e1 e2 ≠ zero 8 := by
    intro hz
    have : e1 = e2 := by
      have h := congrArg (add 8 e1) hz
      rw [← Balanced242Plateau.add_assoc', add_self, add_zero_left, add_zero_right] at h
      exact h.symm
    exact he2_ne1 this.symm
  have he3_ne1 : add 8 e1 e2 ≠ e1 := by
    intro hz
    have h := congrArg (add 8 e1) hz
    rw [← Balanced242Plateau.add_assoc', add_self, add_zero_left] at h
    exact he2_ne h
  have he3_ne2 : add 8 e1 e2 ≠ e2 := by
    intro hz
    have h := congrArg (fun x => add 8 x e2) hz
    dsimp only at h
    rw [Balanced242Plateau.add_assoc', add_self, add_zero_right] at h
    exact he1_ne h
  refine ⟨e1, e2, he1_ne, he2_ne, Ne.symm he2_ne1, he1_rad, he2_rad, he3_rad, fun w => ?_⟩
  constructor
  · intro hw
    have hge (x : W 8) :
        hits (zero 8) x + hits e1 x + hits e2 x + hits (add 8 e1 e2) x ≤ bind (rad β x) := by
      unfold hits
      by_cases h0 : zero 8 = x
      · subst h0
        have h1 : ¬ e1 = zero 8 := he1_ne
        have h2 : ¬ e2 = zero 8 := he2_ne
        have h3 : ¬ add 8 e1 e2 = zero 8 := he3_ne0
        simp only [if_true, h1, h2, h3, if_false, Int.add_zero, rad_zero]; decide
      · by_cases h1 : e1 = x
        · subst h1
          have h2 : ¬ e2 = e1 := he2_ne1
          have h3 : ¬ add 8 e1 e2 = e1 := he3_ne1
          simp only [h0, if_false, if_true, h2, h3, Int.zero_add, Int.add_zero, he1_rad]; decide
        · by_cases h2 : e2 = x
          · subst h2
            have h3 : ¬ add 8 e1 e2 = e2 := he3_ne2
            simp only [h0, h1, if_false, if_true, h3, Int.zero_add, Int.add_zero, he2_rad]; decide
          · by_cases h3 : add 8 e1 e2 = x
            · subst h3
              simp only [h0, h1, h2, if_false, if_true, Int.zero_add, he3_rad]; decide
            · simp only [h0, h1, h2, h3, if_false, Int.add_zero]
              exact Balanced242Plateau.ind_nonneg _
    have hnn (x : W 8) : 0 ≤ bind (rad β x) - (hits (zero 8) x + hits e1 x + hits e2 x + hits (add 8 e1 e2) x) := by
      have := hge x; omega
    have hsum : total 8 (fun x => bind (rad β x) - (hits (zero 8) x + hits e1 x + hits e2 x + hits (add 8 e1 e2) x)) = 0 := by
      rw [total_sub, total_add, total_add, total_add, diagonal, diagonal, diagonal, diagonal]
      change rr β - 4 = 0; omega
    have hpt := point_le_total 8 _ hnn w
    rw [hsum] at hpt
    have h0 := hnn w
    rw [hw] at hpt h0
    unfold hits Balanced242Plateau.ind at hpt h0
    by_cases c0 : zero 8 = w
    · left; exact c0.symm
    · by_cases c1 : e1 = w
      · right; left; exact c1.symm
      · by_cases c2 : e2 = w
        · right; right; left; exact c2.symm
        · by_cases c3 : add 8 e1 e2 = w
          · right; right; right; exact c3.symm
          · simp [c0, c1, c2, c3] at hpt
  · intro hmem
    rcases hmem with rfl | rfl | rfl | rfl
    · exact rad_zero β
    · exact he1_rad
    · exact he2_rad
    · exact he3_rad

private theorem bool8_xor_of_sum_mod2 (b7 b6 b5 b4 b3 b2 b1 b0 : Bool)
    (h : (bind b7 + bind b6 + bind b5 + bind b4 + bind b3 + bind b2 + bind b1 + bind b0) % 2 = 0) :
    xor (xor (xor b7 b6) (xor b5 b4)) (xor (xor b3 b2) (xor b1 b0)) = false := by
  revert b7 b6 b5 b4 b3 b2 b1 b0 h; decide

private theorem walsh4_mod8_eq_00 (v0 v1 v2 v3 : Int)
    (h0 : v0 = 8 ∨ v0 = -8) (h1 : v1 = 8 ∨ v1 = -8)
    (h2 : v2 = 8 ∨ v2 = -8) (h3 : v3 = 8 ∨ v3 = -8)
    (b1 b2 : Bool) :
    decide (((v0 + sign b1 * v1 + sign b2 * v2 + (sign b1 * sign b2) * v3) / 4 / 4) % 2 = 1) =
    decide (((v0 + v1 + v2 + v3) / 4 / 4) % 2 = 1) := by
  rcases h0 with rfl | rfl <;> rcases h1 with rfl | rfl <;>
  rcases h2 with rfl | rfl <;> rcases h3 with rfl | rfl <;>
  cases b1 <;> cases b2 <;> decide

private theorem walsh4_12_weight1 (v0 v1 v2 v3 : Int)
    (h0 : v0 = 12 ∨ v0 = -12) (h1 : v1 = 12 ∨ v1 = -12)
    (h2 : v2 = 12 ∨ v2 = -12) (h3 : v3 = 12 ∨ v3 = -12)
    (hd : ((v0 + v1 + v2 + v3) / 4) % 4 = 0) :
    let z00 := (v0 + v1 + v2 + v3) / 4
    let z01 := (v0 + v1 - v2 - v3) / 4
    let z10 := (v0 - v1 + v2 - v3) / 4
    let z11 := (v0 - v1 - v2 + v3) / 4
    (bind (decide ((z00 / 4) % 2 = 1)) + bind (decide ((z01 / 4) % 2 = 1)) +
     bind (decide ((z10 / 4) % 2 = 1)) + bind (decide ((z11 / 4) % 2 = 1)) = 1) ∧
    (decide ((z00 / 4) % 2 = 1) = true → z00 * z00 = 144) ∧
    (decide ((z01 / 4) % 2 = 1) = true → z01 * z01 = 144) ∧
    (decide ((z10 / 4) % 2 = 1) = true → z10 * z10 = 144) ∧
    (decide ((z11 / 4) % 2 = 1) = true → z11 * z11 = 144) := by
  rcases h0 with rfl | rfl <;> rcases h1 with rfl | rfl <;>
  rcases h2 with rfl | rfl <;> rcases h3 with rfl | rfl <;>
  first | (dsimp only; decide) | (exfalso; simp at hd)

private theorem xor_interchange (a b c d : Bool) :
    xor (xor a c) (xor b d) = xor (xor a b) (xor c d) := by
  cases a <;> cases b <;> cases c <;> cases d <;> rfl

private theorem xor_cancel_pair (a b c : Bool) :
    xor (xor a c) (xor b c) = xor a b := by
  cases a <;> cases b <;> cases c <;> rfl

/-- **Main Theorem (`no_t108_rank6`)**: Complete, unconditional, matrix-free Lean 4 exclusion of
    `t = 108` rank 6 (`rr (β8 f g) = 4`)! Zero `SectionEnum`, zero covering radius! -/
theorem no_t108_rank6 (f g : Half) (res : ∀ a, hi f g a % 8 = 4)
    (dc : lo f g (zero 8) = 0) (lores : ∀ a, lo f g a % 8 = 0)
    (locap : ∀ a, (lo f g a).natAbs ≤ 24) (ht : agreements f g = 108)
    (hrr : rr (β8 f g) = 4) : False := by
  obtain ⟨hn80, hn04, hD_eq_rad⟩ := t108_rank6_D_eq_rad f g res dc lores locap ht hrr
  obtain ⟨e1, e2, he1_ne, he2_ne, he1_ne2, he1_rad, he2_rad, he3_rad, hrad_mem⟩ :=
    radical4_basis (β8 f g) hrr
  have hZc : Zc f g = 112 := by
    have ⟨hb, _, _⟩ := low_defect_budget f g dc lores locap; omega
  have hm8 : many 8 = 256 := by decide
  have hMM : (32 : Int) * 32 = many 8 * rr (β8 f g) := by rw [hm8, hrr]; decide
  have hgood_sx : good (β8 f g) (supportXor g) = true := by
    cases hg : good (β8 f g) (supportXor g)
    · exfalso
      have h0 : transform (q8 f g) (supportXor g) = 0 :=
        (Balanced242Rank.spec_values (β8 f g) (cube8 f g res) 32 hMM (supportXor g)).2 hg
      have hzid := Z_identity f g res dc lores
      rw [h0, Int.mul_zero] at hzid; omega
    · rfl
  -- Exact `lo f g a / 2` values on `W 8`:
  have hlo2_val (a : W 8) :
      (rad (β8 f g) a = true → lo f g a / 2 = 0) ∧
      (rad (β8 f g) a = false → Zset f g a = true → lo f g a / 2 = 8 ∨ lo f g a / 2 = -8) ∧
      (Zset f g a = false → lo f g a / 2 = 12 ∨ lo f g a / 2 = -12) := by
    have hD := hD_eq_rad a
    have hlv := lo_vals f g lores locap a
    unfold Dlo Balanced242Plateau.ind at hD
    unfold Zset
    refine ⟨?_, ?_, ?_⟩
    · intro hr; rw [hr] at hD; rcases hlv with h | h | h | h | h | h | h <;> rw [h] at hD ⊢ <;> simp at hD <;> omega
    · intro hnr hz; rw [hnr] at hD; rcases hlv with h | h | h | h | h | h | h <;> rw [h] at hD hz ⊢ <;> simp at hD hz <;> omega
    · intro hnz
      have hnr : rad (β8 f g) a = false := by
        cases hr : rad (β8 f g) a
        · rfl
        · exfalso; rw [hr] at hD
          rcases hlv with h | h | h | h | h | h | h <;> rw [h] at hD hnz <;> simp at hD hnz
      rw [hnr] at hD
      rcases hlv with h | h | h | h | h | h | h <;> rw [h] at hD hnz ⊢ <;> simp at hD hnz <;> omega
  -- Explicit quadratic formula for `!Zset f g` from `coupled_phase`:
  have hZe (a : W 8) : !Zset f g a = xor (xor (β8 f g a) (β8 f g (zero 8))) (dot 8 a (supportXor g)) := by
    have hc := Balanced242HighSections.coupled_phase f g a; rw [dc] at hc
    have r1 := res a; have r0 := res (zero 8); have l1 := lores a
    unfold Zset β8 Balanced242Plateau.bt H8
    cases hd : dot 8 a (supportXor g) <;> rw [hd] at hc <;>
      simp only [if_true, if_false, Bool.false_eq_true] at hc <;>
      by_cases b1 : hi f g a / 4 / 2 % 2 = 1 <;> by_cases b0 : hi f g (zero 8) / 4 / 2 % 2 = 1 <;>
      by_cases zl : lo f g a % 16 = 0 <;>
      simp only [b1, b0, zl, decide_true, decide_false, Bool.not_true, Bool.not_false,
        Bool.xor_true, Bool.xor_false] <;> first | rfl | omega
  -- `Zset f g` is invariant under shifting by any `w ∈ rad (β8 f g)`! (5-line proof via `hZe`!)
  have hZ_shift (a w : W 8) (hw : rad (β8 f g) w = true) : Zset f g (add 8 a w) = Zset f g a := by
    have hphi := (good_spec (β8 f g)).1 hgood_sx w hw
    unfold phi at hphi
    rw [dot_comm 8 (supportXor g) w] at hphi
    have hrad := rad_shift (β8 f g) w hw a
    have hdot : dot 8 (add 8 a w) (supportXor g) = xor (dot 8 a (supportXor g)) (dot 8 w (supportXor g)) := by
      rw [dot_comm 8 (add 8 a w) _, dot_right, dot_comm 8 _ a, dot_comm 8 _ w]
    have h1 := hZe a
    have h2 := hZe (add 8 a w)
    rw [hrad, hdot] at h2
    revert h1 h2 hphi
    generalize Zset f g (add 8 a w) = z2; generalize Zset f g a = z1
    generalize β8 f g a = ba; generalize β8 f g (zero 8) = b0; generalize β8 f g w = bw
    generalize dot 8 a (supportXor g) = da; generalize dot 8 w (supportXor g) = dw
    revert z2 z1 ba b0 bw da dw; decide
  -- Define the 4 cell functions `Vcell b1 b2` and their Walsh transforms `z b1 b2` on `W 8`!
  let cellInd (b1 b2 : Bool) (y : W 8) : Bool := (dot 8 y e1 == b1) && (dot 8 y e2 == b2)
  let Vcell (b1 b2 : Bool) (y : W 8) : Int := if cellInd b1 b2 y then Vtbl f g y else 0
  let z (b1 b2 : Bool) (a : W 8) : Int := transform (Vcell b1 b2) a
  -- Key 4-point Walsh formula: `4 * z b1 b2 a = L0 + s1*L1 + s2*L2 + s1*s2*L3`!
  have hz_formula (b1 b2 : Bool) (a : W 8) :
      4 * z b1 b2 a =
        (lo f g a / 2) + sign b1 * (lo f g (add 8 a e1) / 2) +
        sign b2 * (lo f g (add 8 a e2) / 2) +
        (sign b1 * sign b2) * (lo f g (add 8 a (add 8 e1 e2)) / 2) := by
    have htrV (c : W 8) : lo f g c / 2 = transform (Vtbl f g) c := by
      have h := lo_eq_2_transform_V f g c; omega
    rw [htrV, htrV, htrV, htrV]
    unfold z transform
    rw [← total_scale, ← total_scale, ← total_scale, ← total_scale,
        ← total_add, ← total_add, ← total_add]
    apply congrArg (total 8); funext y
    have hchr1 : chr (add 8 a e1) y = chr a y * sign (dot 8 y e1) := by
      unfold chr; rw [dot_comm 8 (add 8 a e1) y, dot_right, dot_comm 8 y a, signMul]
    have hchr2 : chr (add 8 a e2) y = chr a y * sign (dot 8 y e2) := by
      unfold chr; rw [dot_comm 8 (add 8 a e2) y, dot_right, dot_comm 8 y a, signMul]
    have hchr3 : chr (add 8 a (add 8 e1 e2)) y = chr a y * (sign (dot 8 y e1) * sign (dot 8 y e2)) := by
      unfold chr; rw [dot_comm 8 (add 8 a (add 8 e1 e2)) y, dot_right, dot_right, dot_comm 8 y a, signMul, signMul]
    rw [hchr1, hchr2, hchr3]
    dsimp only [Vcell, cellInd]
    cases b1 <;> cases b2 <;> cases dot 8 y e1 <;> cases dot 8 y e2 <;> simp [sign] <;> omega
  -- Size of each cell is 64!
  have hcell_size (b1 b2 : Bool) : total 8 (fun y => bind (cellInd b1 b2 y)) = 64 := by
    have hpt (y : W 8) : 4 * bind (cellInd b1 b2 y) =
        1 + sign b1 * chr e1 y + sign b2 * chr e2 y + (sign b1 * sign b2) * chr (add 8 e1 e2) y := by
      have h3 : chr (add 8 e1 e2) y = chr e1 y * chr e2 y := by
        unfold chr; rw [dot_comm 8 (add 8 e1 e2) y, dot_right, dot_comm 8 y e1, dot_comm 8 y e2, signMul]
      rw [h3]; dsimp only [cellInd]; unfold chr Balanced242Plateau.ind
      rw [dot_comm 8 e1 y, dot_comm 8 e2 y]
      cases b1 <;> cases b2 <;> cases dot 8 y e1 <;> cases dot 8 y e2 <;> decide
    have hsum := congrArg (total 8) (funext hpt)
    rw [total_scale, total_add, total_add, total_add, total_const, total_scale, total_scale, total_scale] at hsum
    have hi1 : total 8 (chr e1) = 0 := by
      have h := identity_spectrum 8 e1; change total 8 (chr e1) = _ at h; rw [h]; simp [he1_ne]
    have hi2 : total 8 (chr e2) = 0 := by
      have h := identity_spectrum 8 e2; change total 8 (chr e2) = _ at h; rw [h]; simp [he2_ne]
    have he3_ne : add 8 e1 e2 ≠ zero 8 := by
      intro hz; have h := congrArg (add 8 e1) hz
      rw [← Balanced242Plateau.add_assoc', add_self, add_zero_left, add_zero_right] at h
      exact he1_ne2 h.symm
    have hi3 : total 8 (chr (add 8 e1 e2)) = 0 := by
      have h := identity_spectrum 8 (add 8 e1 e2); change total 8 (chr (add 8 e1 e2)) = _ at h; rw [h]; simp [he3_ne]
    rw [hm8, hi1, hi2, hi3] at hsum; omega
  -- Pointwise properties of `z b1 b2 a`:
  -- (A) On `Zset`: `4 ∣ z b1 b2 a` AND all 4 cells have the SAME `(z/4) % 2`!
  -- (B) Off `Zset`: `2 ∣ z b1 b2 a`, and EITHER all 4 cells are `≡ 2 mod 4` OR all 4 are div by 4 with
  --     EXACTLY ONE cell having `|z| = 12` (odd `z/4`) and the other three having `z = 0`!
  have hz_even (b1 b2 : Bool) (a : W 8) : z b1 b2 a % 2 = 0 := by
    have hf := hz_formula b1 b2 a
    cases hZ : Zset f g a
    · have h0 := (hlo2_val a).2.2 hZ
      have h1 := (hlo2_val (add 8 a e1)).2.2 (by rw [hZ_shift a e1 he1_rad, hZ])
      have h2 := (hlo2_val (add 8 a e2)).2.2 (by rw [hZ_shift a e2 he2_rad, hZ])
      have h3 := (hlo2_val (add 8 a (add 8 e1 e2))).2.2 (by rw [hZ_shift a (add 8 e1 e2) he3_rad, hZ])
      cases b1 <;> cases b2 <;> simp [sign] at hf <;>
        rcases h0 with e0 | e0 <;> rcases h1 with e1' | e1' <;>
        rcases h2 with e2' | e2' <;> rcases h3 with e3' | e3' <;>
        rw [e0, e1', e2', e3'] at hf <;> omega
    · cases hr : rad (β8 f g) a
      · have hnr1 : rad (β8 f g) (add 8 a e1) = false := by rw [add_comm, rad_add _ _ he1_rad]; exact hr
        have hnr2 : rad (β8 f g) (add 8 a e2) = false := by rw [add_comm, rad_add _ _ he2_rad]; exact hr
        have hnr3 : rad (β8 f g) (add 8 a (add 8 e1 e2)) = false := by rw [add_comm, rad_add _ _ he3_rad]; exact hr
        have h0 := (hlo2_val a).2.1 hr hZ
        have h1 := (hlo2_val (add 8 a e1)).2.1 hnr1 (by rw [hZ_shift a e1 he1_rad, hZ])
        have h2 := (hlo2_val (add 8 a e2)).2.1 hnr2 (by rw [hZ_shift a e2 he2_rad, hZ])
        have h3 := (hlo2_val (add 8 a (add 8 e1 e2))).2.1 hnr3 (by rw [hZ_shift a (add 8 e1 e2) he3_rad, hZ])
        cases b1 <;> cases b2 <;> simp [sign] at hf <;>
          rcases h0 with e0 | e0 <;> rcases h1 with e1' | e1' <;>
          rcases h2 with e2' | e2' <;> rcases h3 with e3' | e3' <;>
          rw [e0, e1', e2', e3'] at hf <;> omega
      · have hr1 : rad (β8 f g) (add 8 a e1) = true := by rw [add_comm, rad_add _ _ he1_rad]; exact hr
        have hr2 : rad (β8 f g) (add 8 a e2) = true := by rw [add_comm, rad_add _ _ he2_rad]; exact hr
        have hr3 : rad (β8 f g) (add 8 a (add 8 e1 e2)) = true := by rw [add_comm, rad_add _ _ he3_rad]; exact hr
        rw [(hlo2_val a).1 hr, (hlo2_val _).1 hr1, (hlo2_val _).1 hr2, (hlo2_val _).1 hr3] at hf
        omega
  have hz_div4_on_Z (b1 b2 : Bool) (a : W 8) (hZ : Zset f g a = true) : z b1 b2 a % 4 = 0 := by
    have hf := hz_formula b1 b2 a
    cases hr : rad (β8 f g) a
    · have hnr1 : rad (β8 f g) (add 8 a e1) = false := by rw [add_comm, rad_add _ _ he1_rad]; exact hr
      have hnr2 : rad (β8 f g) (add 8 a e2) = false := by rw [add_comm, rad_add _ _ he2_rad]; exact hr
      have hnr3 : rad (β8 f g) (add 8 a (add 8 e1 e2)) = false := by rw [add_comm, rad_add _ _ he3_rad]; exact hr
      have h0 := (hlo2_val a).2.1 hr hZ
      have h1 := (hlo2_val (add 8 a e1)).2.1 hnr1 (by rw [hZ_shift a e1 he1_rad, hZ])
      have h2 := (hlo2_val (add 8 a e2)).2.1 hnr2 (by rw [hZ_shift a e2 he2_rad, hZ])
      have h3 := (hlo2_val (add 8 a (add 8 e1 e2))).2.1 hnr3 (by rw [hZ_shift a (add 8 e1 e2) he3_rad, hZ])
