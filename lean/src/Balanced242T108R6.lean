          rw [hZc_eq, ← Zc_eq_total_Zset, hZc]
        · right
          have hpt (c : W 8) : sign (ah c) * chr u c = -1 := by
            have hle (x : W 8) : 0 ≤ 1 + sign (ah x) * chr u x := by
              unfold chr; cases ah x <;> cases dot 8 u x <;> decide
            have hsum : total 8 (fun x => 1 + sign (ah x) * chr u x) = 0 := by
              rw [total_add, total_const, hm8]; change 256 + transform (fun x => sign (ah x)) u = 0; omega
            have hp := point_le_total 8 _ hle c; rw [hsum] at hp; have h0 := hle c; omega
          have hZc_eq : transform (fun c => bind (Zset f g c)) u = -total 8 (fun c => bind (Zset f g c)) := by
            have hneg_t : -total 8 (fun c => bind (Zset f g c)) = total 8 (fun c => (-1 : Int) * bind (Zset f g c)) := by
