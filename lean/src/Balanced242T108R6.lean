      by_cases c6 : z b1 b2 (add 8 q c) / 2 % 2 = 1 <;>
      by_cases c5 : z b1 b2 (add 8 p c) / 2 % 2 = 1 <;>
      by_cases c4 : z b1 b2 c / 2 % 2 = 1 <;>
      simp only [c7, c6, c5, c4, decide_true, decide_false, Bool.xor_false, Bool.xor_true] <;>
      first | rfl | omega
