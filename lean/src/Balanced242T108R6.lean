    have d6 := hz_div4_all b1 b2 (add 8 v (add 8 w c))
    have d5 := hz_div4_all b1 b2 (add 8 u (add 8 w c))
    have d4 := hz_div4_all b1 b2 (add 8 w c)
    have d3 := hz_div4_all b1 b2 (add 8 u (add 8 v c))
    have d2 := hz_div4_all b1 b2 (add 8 v c)
    have d1 := hz_div4_all b1 b2 (add 8 u c)
    have d0 := hz_div4_all b1 b2 c
    -- Sum of 8 parities mod 2 is 0!
    have hsum2 :
        (z b1 b2 (add 8 u (add 8 v (add 8 w c))) / 4 + z b1 b2 (add 8 v (add 8 w c)) / 4 +
